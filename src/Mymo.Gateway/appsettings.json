{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5079" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "swagger-identity": { "ClusterId": "identity", "Order": -20, "Match": { "Path": "/swagger-docs/identity/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger-docs/identity" } ] },
      "swagger-social": { "ClusterId": "social", "Order": -20, "Match": { "Path": "/swagger-docs/social/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger-docs/social" } ] },
      "swagger-map": { "ClusterId": "map", "Order": -20, "Match": { "Path": "/swagger-docs/map/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger-docs/map" } ] },
      "swagger-chat": { "ClusterId": "chat", "Order": -20, "Match": { "Path": "/swagger-docs/chat/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger-docs/chat" } ] },
      "swagger-business": { "ClusterId": "business", "Order": -20, "Match": { "Path": "/swagger-docs/business/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/swagger-docs/business" } ] },
      "auth": { "ClusterId": "identity", "Order": 0, "Match": { "Path": "/api/Auth/{**catch-all}" } },
      "users-premium": { "ClusterId": "business", "Order": -10, "Match": { "Path": "/api/users/premium/{**catch-all}" } },
      "users-posts": { "ClusterId": "social", "Order": -10, "Match": { "Path": "/api/users/{id}/posts" } },
      "users": { "ClusterId": "identity", "Order": 0, "Match": { "Path": "/api/users/{**catch-all}" } },
      "posts": { "ClusterId": "social", "Order": 0, "Match": { "Path": "/api/posts/{**catch-all}" } },
      "comments": { "ClusterId": "social", "Order": 0, "Match": { "Path": "/api/comments/{**catch-all}" } },
      "friends": { "ClusterId": "social", "Order": 0, "Match": { "Path": "/api/friends/{**catch-all}" } },
      "notifications": { "ClusterId": "social", "Order": 0, "Match": { "Path": "/api/notifications/{**catch-all}" } },
      "media": { "ClusterId": "social", "Order": 0, "Match": { "Path": "/api/media/{**catch-all}" } },
      "mymy": { "ClusterId": "social", "Order": 0, "Match": { "Path": "/api/mymy/{**catch-all}" } },
      "uploads": { "ClusterId": "social", "Order": 0, "Match": { "Path": "/uploads/{**catch-all}" } },
      "places-menu": { "ClusterId": "business", "Order": -10, "Match": { "Path": "/api/places/{id}/menu" } },
      "places-promos": { "ClusterId": "business", "Order": -10, "Match": { "Path": "/api/places/{id}/promotions" } },
      "places": { "ClusterId": "map", "Order": 0, "Match": { "Path": "/api/places/{**catch-all}" } },
      "reviews": { "ClusterId": "map", "Order": 0, "Match": { "Path": "/api/reviews/{**catch-all}" } },
      "checkins": { "ClusterId": "map", "Order": 0, "Match": { "Path": "/api/checkins/{**catch-all}" } },
      "weather": { "ClusterId": "map", "Order": 0, "Match": { "Path": "/api/weather/{**catch-all}" } },
      "categories": { "ClusterId": "map", "Order": 0, "Match": { "Path": "/api/place-categories/{**catch-all}" } },
      "hubs-map": { "ClusterId": "map", "Order": 0, "Match": { "Path": "/hubs/map/{**catch-all}" } },
      "conversations": { "ClusterId": "chat", "Order": 0, "Match": { "Path": "/api/conversations/{**catch-all}" } },
      "messages": { "ClusterId": "chat", "Order": 0, "Match": { "Path": "/api/messages/{**catch-all}" } },
      "hubs-chat": { "ClusterId": "chat", "Order": 0, "Match": { "Path": "/hubs/chat/{**catch-all}" } },
      "business": { "ClusterId": "business", "Order": 0, "Match": { "Path": "/api/business/{**catch-all}" } },
      "catalog": { "ClusterId": "business", "Order": 0, "Match": { "Path": "/api/catalog/{**catch-all}" } },
      "admin-places": { "ClusterId": "map", "Order": -10, "Match": { "Path": "/api/admin/places/{**catch-all}" } },
      "admin-businesses": { "ClusterId": "business", "Order": -10, "Match": { "Path": "/api/admin/businesses/{**catch-all}" } },
      "admin-billing": { "ClusterId": "business", "Order": -10, "Match": { "Path": "/api/admin/billing/{**catch-all}" } },
      "admin": { "ClusterId": "identity", "Order": 0, "Match": { "Path": "/api/admin/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5001" } } },
      "social": { "Destinations": { "d1": { "Address": "http://localhost:5002" } } },
      "map": { "Destinations": { "d1": { "Address": "http://localhost:5003" } } },
      "chat": { "Destinations": { "d1": { "Address": "http://localhost:5004" } } },
      "business": { "Destinations": { "d1": { "Address": "http://localhost:5005" } } }
    }
  }
}

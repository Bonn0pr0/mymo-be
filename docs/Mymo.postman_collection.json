            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"33333333-3333-3333-3333-333333333333\"\n}"
            },
            "url": "{{gatewayUrl}}/api/conversations/private"
          }
        }
      ]
    },
    {
      "name": "5. Business, Premium & Admin Billing Service",
      "item": [
        {
          "name": "Get Product Packages Catalog (/api/catalog/product-packages)",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/catalog/product-packages"
          }
        },
        {
          "name": "Create User Premium Order (/api/users/premium/orders)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"monthly\"\n}"
            },
            "url": "{{gatewayUrl}}/api/users/premium/orders"
          }
        },
        {
          "name": "Get Admin Dashboard Overview (/api/admin/dashboard)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{gatewayUrl}}/api/admin/dashboard"
          }
        }
      ]
    }
  ]
}

# Copy this file to .env and fill in the three required values.
# Generate a separate random value of at least 32 characters for each key.
MYMO_JWT_SECRET=
MYMO_INTERNAL_KEY=
# Use only URL-safe characters, such as hexadecimal, in the RabbitMQ password.
MYMO_RABBITMQ_PASSWORD=

# Only needed with docker compose --profile postgres.
MYMO_POSTGRES_PASSWORD=

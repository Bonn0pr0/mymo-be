# Copy this file to .env and fill in the required values.
MYMO_JWT_SECRET=your_jwt_secret_32_characters_long
MYMO_INTERNAL_KEY=your_internal_key_here
MYMO_RABBITMQ_PASSWORD=your_rabbitmq_password
GEMINI_API_KEY=your_gemini_api_key_here
MYMO_GEMINI_MODEL=gemini-1.5-flash

# SQL Server & Gateway
MYMO_MSSQL_PASSWORD=YourStrong@Passw0rd
MYMO_GATEWAY_PORT=5079
MYMO_PUBLIC_ORIGIN=http://localhost:5079
